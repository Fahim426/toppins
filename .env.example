# Show sample menu items in production builds (default: hidden). Dev always shows them.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# Production origin, no trailing slash. Used for canonical URLs, sitemap, robots, Open Graph
# and JSON-LD. Until set (here or in src/data/site.ts), canonicals point at https://example.com
# and JSON-LD omits its url.
# NEXT_PUBLIC_SITE_URL=https://www.your-domain.example
